NEXT_PUBLIC_MOCK_MODE=true
AUTH_MODE=mock
DATABASE_URL=postgresql://demo:demo@localhost:5432/mali_demo
DIRECT_URL=postgresql://demo:demo@localhost:5432/mali_demo
NEXTAUTH_URL=http://localhost:3000
# Za lokalni preizkus; za objavo nastavi svojo naključno skrivnost.
NEXTAUTH_SECRET=
# Za pravi katalog izklopi MOCK_MODE ter konfiguriraj bazo, Stripe in dobavitelja.

# Podatke nastavi lokalno; skrivnosti ne sodijo v Git.
SUPPLIER_NAME=
SUPPLIER_FEED_URL=
SUPPLIER_API_KEY=
# Dovoljena gostiteljska imena slik (brez https://), ločena z vejico. Po spremembi ponovno zgradi aplikacijo.
SUPPLIER_IMAGE_HOSTS=
# Set locally before running db:seed (at least 16 characters, at most 72 bytes).
ADMIN_NEW_PASSWORD=
