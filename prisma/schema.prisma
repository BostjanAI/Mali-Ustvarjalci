generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("customer") // 'admin' or 'customer'
  passwordHash  String?

  accounts  Account[]
  sessions  Session[]
  orders    Order[]
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @map("refresh_token")
  access_token      String? @map("access_token")
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Supplier {
  id            String  @id @default(cuid())
  name          String
  apiUrl        String?
  authToken     String?
  orderAuthToken String?
  orderWebhookToken String?
  orderForwardingEnabled Boolean @default(false)
  shippingServicesJson String?
  orderAdapter String @default("generic-v1")
  orderApiUsername String?
  orderApiNextAt DateTime?
  syncFrequency String? // cron-like string or enum
  active        Boolean @default(true)
  feedUrl       String?
  lastSyncedAt  DateTime?

  dispatches SupplierDispatch[]
  products Product[]
  syncLogs SyncLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Product {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String?
  priceCents  Int
  currency    String  @default("EUR")
  vatRate     Int     @default(22)
  active      Boolean @default(true)
  imagesJson  String?
  detailsJson String?
  supplierCategoryPath String?
  catalogReviewedAt DateTime?
  imagesVerifiedAt DateTime?

  supplierId        String?
  supplierProductId String?
  lastSyncedAt      DateTime?
  supplierManaged   Boolean   @default(true)
  stockManaged Boolean @default(true)
  priceManaged Boolean @default(false)
  costPriceCents Int?
  supplierPriceCents Int?

  brand        String?
  categoryPath String?

  variants  ProductVariant[]
  inventory Inventory?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier   Supplier?   @relation(fields: [supplierId], references: [id])
  orderItems OrderItem[]

  @@unique([supplierId, supplierProductId])
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  name       String
  sku        String  @unique
  priceCents Int
  currency   String  @default("EUR")
  active     Boolean @default(true)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
}

model Inventory {
  id              String @id @default(cuid())
  productId       String @unique
  quantity        Int    @default(0)
  allocatedQuantity Int @default(0)
  lastSupplierQty Int?
  syncedAt DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id                    String  @id @default(cuid())
  userId                String?
  email                 String
  totalCents            Int
  currency              String  @default("EUR")
  vatRate               Int     @default(22)
  stripeCheckoutSessionId String? @unique
  shippingAddressJson String?
  shippingServiceJson String?
  reservationId String? @unique
  refundState String @default("none")
  fulfillmentHold String?
  stripePaymentIntentId String?
  status                String  @default("created")

  forwardedToSupplierAt DateTime?
  supplierOrderId       String?
  supplierStatus        String?   @default("pending")
  supplierId            String?

  reservation CheckoutReservation? @relation(fields:[reservationId],references:[id])
  refunds RefundOperation[]
  dispatches SupplierDispatch[]
  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?     @relation(fields: [userId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  variantId      String?
  supplierId     String?
  supplierProductId String?
  title          String
  sku            String?
  unitPriceCents Int
  quantity       Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
}

model SyncLog {
  id          String   @id @default(cuid())
  supplierId  String?
  type        String // 'sync' or 'import'
  added       Int      @default(0)
  updated     Int      @default(0)
  deactivated Int      @default(0)
  errors      Int      @default(0)
  message     String?
  createdAt   DateTime @default(now())

  supplier Supplier? @relation(fields: [supplierId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  metadata  String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model SupplierDispatch {
  id String @id @default(cuid())
  orderId String
  supplierId String
  requestJson String
  endpointUrl String?
  status String @default("pending")
  supplierOrderId String?
  supplierStatus String?
  trackingNumber String?
  attempts Int @default(0)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime @default(now())
  retryAlertedAt DateTime?
  reconciliationStatus String @default("none")
  reconciliationNote String?
  stockAccountedAt DateTime?
  labelUrl String?
  trackingNotifications TrackingNotification[]
  sentAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id])
  @@unique([orderId, supplierId])
  @@unique([supplierId, supplierOrderId])
  @@index([status, lastAttemptAt])
}

model CheckoutReservation {
 id String @id @default(cuid())
 status String @default("creating")
 reconcileAfter DateTime @default(now())
 reconcileAttempts Int @default(0)
 reconciliationError String?
 stripeSessionId String? @unique
 cartJson String
 stripeRequestJson String?
 shippingServiceJson String?
 expiresAt DateTime
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 items ReservationItem[]
 order Order?
 @@index([status,expiresAt])
 @@index([status,reconcileAfter])
}
model ReservationItem {
 id String @id @default(cuid())
 reservationId String
 productId String
 supplierId String?
 quantity Int
 status String @default("held")
 reservation CheckoutReservation @relation(fields:[reservationId],references:[id],onDelete:Cascade)
 @@unique([reservationId,productId])
 @@index([productId,status])
}
model RefundOperation {
 id String @id @default(cuid())
 orderId String
 requestKey String @unique
 amountCents Int
 status String @default("requested")
 stripeRefundId String? @unique
 requestedBy String
 lastError String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 order Order @relation(fields:[orderId],references:[id])
 @@index([orderId,status])
}
model OperationsAlert {
 id String @id @default(cuid())
 key String @unique
 code String
 orderId String?
 dispatchId String?
 acknowledgedAt DateTime?
 createdAt DateTime @default(now())
}

model TrackingNotification {
 id String @id @default(cuid())
 dispatchId String
 trackingNumber String
 status String @default("pending")
 attempts Int @default(0)
 attemptToken String?
 nextAttemptAt DateTime @default(now())
 sentAt DateTime?
 lastError String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 dispatch SupplierDispatch @relation(fields:[dispatchId],references:[id],onDelete:Cascade)
 @@unique([dispatchId,trackingNumber])
 @@index([status,nextAttemptAt])
}
